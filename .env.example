# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Only the public anon / publishable key belongs here. NEVER the service_role key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-or-publishable-key>

# Push notifications: the PUBLIC VAPID key only (README → Notifikace). Optional.
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>
